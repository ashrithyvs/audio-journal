{
  "name": "AudioJournal",
  "version": "0.1.0-aj0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "start": "react-native start",
    "test": "jest",
    "test:unit": "jest --runInBand --selectProjects unit",
    "test:smoke": "jest --runInBand --selectProjects smoke",
    "test:integration": "jest --runInBand --selectProjects integration",
    "test:performance": "jest --runInBand --selectProjects performance",
    "test:baseline": "npm run format:check && npm run typecheck && npm run lint && npm run test:unit && npm run test:smoke && npm run test:integration && npm run test:performance",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\" \"unit-tests/**/*.ts\" \"integration-tests/**/*.tsx\" \"smoke-tests/**/*.tsx\" \"performance-tests/**/*.ts\" \"e2e/**/*.mjs\"",
    "e2e:android:aj3": "node e2e/android/aj3-e2e.mjs"
  },
  "dependencies": {
    "@hybrid-ai/react-native": "file:../hybrid-ai-packages/c4b302e/hybrid-ai-react-native-0.1.0-m5.tgz",
    "@react-navigation/bottom-tabs": "7.20.0",
    "@react-navigation/native": "7.5.0",
    "@react-navigation/native-stack": "7.20.0",
    "react": "19.2.3",
    "react-native": "0.87.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.28.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/eslint-config": "0.87.0",
    "@react-native/jest-preset": "0.87.0",
    "@react-native/metro-config": "0.87.0",
    "@react-native/typescript-config": "0.87.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "^29.5.13",
    "@types/node": "22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "codegenConfig": {
    "name": "AudioJournalSpec",
    "type": "modules",
    "jsSrcsDir": "src/native",
    "android": {
      "javaPackageName": "com.audiojournal.specs"
    }
  }
