{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://audio-journal.invalid/schemas/journal/v1/organize-input.schema.json",
  "title": "journal.organize@1 request input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "requestKey",
    "locale",
    "timeZone",
    "kinds",
    "entries"
  ],
  "properties": {
    "contract": {
      "const": "journal.organize@1"
    },
    "requestKey": {
      "type": "string",
      "pattern": "^org_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
    },
    "timeZone": {
      "type": "string",
      "pattern": "^(UTC|[A-Za-z]+(/[A-Za-z0-9_+-]+){0,2})$",
      "maxLength": 64
    },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "summary",
          "sections",
          "tasks",
          "ideas",
          "people",
          "projects"
        ]
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entryId",
              "kind",
              "createdAt",
              "recordingId",
              "transcriptRevision",
              "durationMs",
              "units"
            ],
            "properties": {
              "entryId": {
                "type": "string",
                "pattern": "^ent_[0-9a-hjkmnp-tv-z]{26}$"
              },
              "kind": {
                "const": "voice"
              },
              "createdAt": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
              },
              "recordingId": {
                "type": "string",
                "pattern": "^rec_[0-9a-hjkmnp-tv-z]{26}$"
              },
              "transcriptRevision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "durationMs": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600000
              },
              "units": {
                "type": "array",
                "minItems": 1,
                "maxItems": 400,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "unitId",
                    "text",
                    "sha256",
                    "startMs",
                    "endMs"
                  ],
                  "properties": {
                    "unitId": {
                      "type": "string",
                      "pattern": "^seg_[0-9a-hjkmnp-tv-z]{26}$"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "startMs": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 3599999
                    },
                    "endMs": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 3600000
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entryId",
              "kind",
              "createdAt",
              "units"
            ],
            "properties": {
              "entryId": {
                "type": "string",
                "pattern": "^ent_[0-9a-hjkmnp-tv-z]{26}$"
              },
              "kind": {
                "const": "written"
              },
              "createdAt": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
              },
              "units": {
                "type": "array",
                "minItems": 1,
                "maxItems": 400,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "unitId",
                    "text",
                    "sha256",
                    "offset"
                  ],
                  "properties": {
                    "unitId": {
                      "type": "string",
                      "pattern": "^w[0-9]{1,3}$"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "offset": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 199999
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
